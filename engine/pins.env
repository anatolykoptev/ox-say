# Upstream engine pins. Bump both together and re-check that every patch in
# engine/patches applies cleanly (engine/build.sh fails loudly if not).
QWENTTS_REPO=https://github.com/ServeurpersoCom/qwentts.cpp
QWENTTS_COMMIT=6fae92914045cd83364d2845ceaa0f7969727319
# The ggml submodule commit recorded by QWENTTS_COMMIT (ServeurpersoCom/ggml fork).
# Bumping it: also apply patches/ggml-tests to the ggml tree and run
# `GGML_METAL_MPS_ENABLE=1 test-backend-ops -o MUL_MAT -b MTL0` (the MPS path is opt-in: without the
# variable the run never reaches it and passes vacuously; see README).
GGML_COMMIT=40e16e4a814f7fe851a0c486fb9e8c722e957830
# Our fork of ServeurpersoCom/ggml, which force-pushes master on every sync — the pinned commit is
# orphaned there and stays fetchable only while the fork's tag ox-say-pin-<first 7 of GGML_COMMIT>
# points at it. Bumping GGML_COMMIT means pushing that tag to the fork first; build.sh refuses a pin
# with no tag.
GGML_REPO=https://github.com/anatolykoptev/ggml2

# Speech-to-text engine (Parakeet TDT + Whisper); its vendored ggml takes engine/patches/ggml.
WHISPER_REPO=https://github.com/ggml-org/whisper.cpp
WHISPER_COMMIT=6e4ab854f67f743900934a703d5603419384c961

# Meeting-notes engine: llama.cpp's llama-server, shipped as ox-llm. llama.cpp vendors a ggml of
# its own (newer than whisper.cpp's and qwentts's), so engine/patches/ggml does not apply to it.
# v0.7.0 is the latest stable release at the time of the pin; the notes spike measured build 11429
# (d81235049384534c167caea52b85a694f6103d14, v0.6.0). If v0.7.0 fails the notes smoke run
# (plans/ox-say/2026-10-23-meeting-notes-p1-tasks.md, Task 9), pin the measured commit instead and
# write the reason here.
LLAMACPP_REPO=https://github.com/ggml-org/llama.cpp
LLAMACPP_COMMIT=620d2225cc436ab0b001e3200e590e3b286ef9ab

# Quality TTS engine (VoxCPM2) — Apple Silicon only. Carries engine/patches/audiocpp.
# AUDIOCPP_COMMIT is the commit v0.9.1 points at (git rev-parse v0.9.1^{commit}); the tag object
# f04de8ec... is not a commit and must not stand in for it.
# Bumping it: rerun the S1 parity gate of plans/ox-say/2026-10-14-voxcpm2-engine.md (Task 1)
# before merging — the pin is the quality claim.
AUDIOCPP_REPO=https://github.com/0xShug0/audio.cpp
AUDIOCPP_COMMIT=cf124a67cc55d8f65a9a15eec69edbff0fb212c8
