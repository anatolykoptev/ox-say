diff --git a/src/gguf-weights.h b/src/gguf-weights.h
index 561ff66..fdc7c66 100644
--- a/src/gguf-weights.h
+++ b/src/gguf-weights.h
@@ -214,6 +214,45 @@ static struct ggml_tensor * gf_try_load_tensor(WeightCtx * wctx, const GGUFModel
 
 // Load tensor, converting to F32 at load time (eliminates runtime cast nodes).
 // Best for small tensors: norms [H], QK-norms [D], scale_shift_table [H,6], biases.
+// Load 2D weights that share row size and type as one tensor, rows stacked in the given order.
+// One mul_mat on the result replaces one mul_mat per part (Q/K/V, gate/up).
+static struct ggml_tensor * gf_load_rows_fused(WeightCtx *                      wctx,
+                                               const GGUFModel &                gf,
+                                               const std::vector<std::string> & names,
+                                               const std::string &              fused_name) {
+    std::vector<const struct ggml_tensor *> srcs;
+    std::vector<const void *>               datas;
+    int64_t                                 ne1 = 0;
+    for (const std::string & n : names) {
+        const int64_t              idx = gguf_find_tensor(gf.gguf, n.c_str());
+        const struct ggml_tensor * src = ggml_get_tensor(gf.meta, n.c_str());
+        if (idx < 0 || !src) {
+            qt_throw("[GGUF] tensor '%s' not found", n.c_str());
+        }
+        if (ggml_n_dims(src) != 2 || (!srcs.empty() && (src->type != srcs[0]->type || src->ne[0] != srcs[0]->ne[0]))) {
+            qt_throw("[GGUF] tensor '%s' cannot be fused: needs 2D, same type and row size", n.c_str());
+        }
+        srcs.push_back(src);
+        datas.push_back(gf.mapping + gf.data_offset + gguf_get_tensor_offset(gf.gguf, idx));
+        ne1 += src->ne[1];
+    }
+    if (srcs.empty()) {
+        qt_throw("[GGUF] empty fused tensor '%s'", fused_name.c_str());
+    }
+
+    struct ggml_tensor * tensor = ggml_new_tensor_2d(wctx->ctx, srcs[0]->type, srcs[0]->ne[0], ne1);
+    ggml_set_name(tensor, fused_name.c_str());
+
+    size_t offset = 0;
+    for (size_t i = 0; i < srcs.size(); i++) {
+        const size_t nbytes = ggml_nbytes(srcs[i]);
+        wctx->pending.push_back({ tensor, datas[i], nbytes, offset });
+        offset += nbytes;
+    }
+    GGML_ASSERT(offset == ggml_nbytes(tensor));
+    return tensor;
+}
+
