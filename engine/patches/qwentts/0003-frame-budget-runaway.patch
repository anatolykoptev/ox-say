diff --git a/src/frame-budget.h b/src/frame-budget.h
new file mode 100644
index 0000000..bce4557
--- /dev/null
+++ b/src/frame-budget.h
@@ -0,0 +1,16 @@
+#pragma once
+// frame-budget.h: the most frames one request may generate, derived from the
+// length of its text. Speech runs at 12.5 frames/s, so a talker that never
+// emits EOS would otherwise run to max_new_tokens (2048 frames, 164 s) for a
+// three-word request. The constants come from measured speech rates; the
+// derivation is in engine/README.md "Speech length".
+
+#define QT_FRAME_BUDGET_PER_TOKEN 8
+#define QT_FRAME_BUDGET_BASE      60
+
+// n_text_tokens is the utterance's BPE token count (PromptBuilderOutput::N_text).
+// The result never exceeds max_new_tokens (the caller's cap).
+static inline int qt_frame_budget(int n_text_tokens, int max_new_tokens) {
+    const long long b = (long long) QT_FRAME_BUDGET_PER_TOKEN * (n_text_tokens < 0 ? 0 : n_text_tokens) + QT_FRAME_BUDGET_BASE;
+    return b < (long long) max_new_tokens ? (int) b : max_new_tokens;
+}
