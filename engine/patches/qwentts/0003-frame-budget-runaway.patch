 // Map an ABI status to an HTTP code. The two ABIs share numeric values:
 // -1 invalid params, -2 mode/instruct invalid -> client error ; the rest
 // are server side failures.
+// A take whose talker hit its frame budget without ending (qt_synthesize
+// failed with "runaway: ..."). Not a qt_status: it only exists between the
+// backend adapter and the HTTP layer, which answers it with a typed error so
+// the supervising process can tell it from a crash.
+#define TTS_RC_RUNAWAY (-100)
+
+static const char * tts_error_type(int rc) {
+    return rc == TTS_RC_RUNAWAY ? "generation_runaway" : "server_error";
+}
