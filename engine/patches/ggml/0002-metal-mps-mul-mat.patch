+bool ggml_metal_op_mul_mat_use_mps(const ggml_tensor * op, bool use_mps_mul_mat) {
+    const ggml_tensor * src0 = op->src[0];
+    const ggml_tensor * src1 = op->src[1];
+
+    // plain 2D products with element-contiguous rows; an fp16 src0 is widened into the scratch after
+    // dst, which only exists for a dst allocated through get_alloc_size (not a view)
+    return use_mps_mul_mat &&
+        op->type == GGML_TYPE_F32 && ggml_is_contiguous(op) && op->view_src == nullptr &&
+        (src0->type == GGML_TYPE_F32 || (src0->type == GGML_TYPE_F16 && ggml_is_contiguous(src0))) &&
+        src1->type == GGML_TYPE_F32 &&
+        src0->ne[2] == 1 && src0->ne[3] == 1 && src1->ne[2] == 1 && src1->ne[3] == 1 &&
+        src0->nb[0] == ggml_type_size(src0->type) && src1->nb[0] == sizeof(float) &&
+        src0->ne[0] % 4 == 0 &&
+        src0->ne[0] >= 64 && src0->ne[1] >= 64 && src1->ne[1] >= 64;
+}
+
+size_t ggml_metal_op_mul_mat_extra_mps(const ggml_tensor * op, bool use_mps_mul_mat) {
+    if (!ggml_metal_op_mul_mat_use_mps(op, use_mps_mul_mat) || op->src[0]->type != GGML_TYPE_F16) {
+        return 0;
+    }
+
+    // the scratch starts at the first 256-byte boundary after dst
+    return GGML_PAD(ggml_nelements(op->src[0])*sizeof(float), 256) + 256;
+}
