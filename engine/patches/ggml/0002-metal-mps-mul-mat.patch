+void ggml_metal_encoder_mps_mul_mat(ggml_metal_encoder_t encoder,
+        struct ggml_metal_buffer_id a, size_t a_row_bytes,
+        struct ggml_metal_buffer_id b, size_t b_row_bytes,
+        struct ggml_metal_buffer_id c, size_t c_row_bytes,
+        int M, int N, int K) {
+    @autoreleasepool {
+        for (int i = 0; i < encoder->n_debug_groups; ++i) {
+            [encoder->obj popDebugGroup];
+        }
+        [encoder->obj endEncoding];
+        [encoder->obj release];
+        encoder->obj = nil;
+
+        MPSMatrixDescriptor * da = [MPSMatrixDescriptor matrixDescriptorWithRows:M columns:K rowBytes:a_row_bytes dataType:MPSDataTypeFloat32];
+        MPSMatrixDescriptor * db = [MPSMatrixDescriptor matrixDescriptorWithRows:N columns:K rowBytes:b_row_bytes dataType:MPSDataTypeFloat32];
+        MPSMatrixDescriptor * dc = [MPSMatrixDescriptor matrixDescriptorWithRows:N columns:M rowBytes:c_row_bytes dataType:MPSDataTypeFloat32];
+
+        MPSMatrix * ma = [[[MPSMatrix alloc] initWithBuffer:(id<MTLBuffer>) a.metal offset:a.offs descriptor:da] autorelease];
+        MPSMatrix * mb = [[[MPSMatrix alloc] initWithBuffer:(id<MTLBuffer>) b.metal offset:b.offs descriptor:db] autorelease];
+        MPSMatrix * mc = [[[MPSMatrix alloc] initWithBuffer:(id<MTLBuffer>) c.metal offset:c.offs descriptor:dc] autorelease];
+
+        MPSMatrixMultiplication * mm = [[[MPSMatrixMultiplication alloc] initWithDevice:encoder->cmd_buf.device
+                                                                          transposeLeft:NO
+                                                                         transposeRight:YES
+                                                                             resultRows:N
+                                                                          resultColumns:M
+                                                                        interiorColumns:K
+                                                                                  alpha:1.0
+                                                                                   beta:0.0] autorelease];
+
+        [mm encodeToCommandBuffer:encoder->cmd_buf leftMatrix:mb rightMatrix:ma resultMatrix:mc];
+
+        encoder->obj = ggml_metal_encoder_new_obj(encoder->cmd_buf, encoder->concurrent);
+
+        // ops push one group each, so the innermost name is the one to restore
+        NSString * group = [NSString stringWithCString:encoder->debug_group encoding:NSUTF8StringEncoding];
+        for (int i = 0; i < encoder->n_debug_groups; ++i) {
+            [encoder->obj pushDebugGroup:group];
+        }
+    }
+}
