+// fp16 -> fp32 widening of a contiguous buffer, 4 elements per thread (n4 = n/4)
+kernel void kernel_cvt_f16_f32(
+        constant uint   & n4,
+        device const half4 * src,
+        device      float4 * dst,
+        uint i [[thread_position_in_grid]]) {
+    if (i < n4) {
+        dst[i] = float4(src[i]);
+    }
+}
