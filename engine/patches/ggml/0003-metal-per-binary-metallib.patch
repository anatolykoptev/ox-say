+                            lib_mm = [device newLibraryWithURL:[NSURL fileURLWithPath:path_mm] error:&error_mm];
+                            if (!lib_mm && error_mm) {
+                                GGML_LOG_ERROR("%s: %s\n", __func__, [[error_mm description] UTF8String]);
+                            }
+                        }
+
+                        if (lib_mm) {
+                            GGML_LOG_INFO("%s: loaded '%s'\n", __func__, [path_mm UTF8String]);
