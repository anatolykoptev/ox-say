+// tiled matrix multiplication for GPUs without simdgroup matrix support (AMD, Intel)
+// each threadgroup computes a 64x64 block of dst, each of the 256 threads a 4x4 block
+template<typename T0, typename T1>
+kernel void kernel_mul_mm_tg(
+        constant ggml_metal_kargs_mul_mm & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        threadgroup  char * shmem [[threadgroup(0)]],
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiitg[[thread_index_in_threadgroup]]) {
+    constexpr short BM = 64;
+    constexpr short BN = 64;
+    constexpr short BK = 16;
+
+    threadgroup float * sa = (threadgroup float *) shmem; // [BK][BM]
+    threadgroup float * sb = sa + BK*BM;                  // [BK][BN]
+
+    const int im = tgpig.z;
+    const int r0 = tgpig.x*BM;
+    const int r1 = tgpig.y*BN;
+
+    const int i12 = im % args.ne12;
+    const int i13 = im / args.ne12;
+
+    device const char * a0 = src0 + (uint64_t)(i12/args.r2)*args.nb02 + (uint64_t)(i13/args.r3)*args.nb03;
+    device const char * b0 = src1 + (uint64_t) i12*args.nb12 + (uint64_t) i13*args.nb13;
+
+    const short tx = tiitg % 16;
+    const short ty = tiitg / 16;
+
+    // each thread loads 4 consecutive k of one row of each tile
+    const short lr = tiitg / 4;
+    const short lk = (tiitg % 4)*4;
+
+    const bool va = r0 + lr < args.ne0;
+    const bool vb = r1 + lr < args.ne1;
+
+    device const T0 * pa = (device const T0 *)(a0 + (uint64_t)(va ? r0 + lr : 0)*args.nb01);
+    device const T1 * pb = (device const T1 *)(b0 + (uint64_t)(vb ? r1 + lr : 0)*args.nb11);
+
+    float acc[4][4] = { { 0.0f } };
+
+    for (int k0 = 0; k0 < args.ne00; k0 += BK) {
+        for (short i = 0; i < 4; i++) {
+            const int k = k0 + lk + i;
+            sa[(lk + i)*BM + lr] = (va && k < args.ne00) ? (float) pa[k] : 0.0f;
+            sb[(lk + i)*BN + lr] = (vb && k < args.ne00) ? (float) pb[k] : 0.0f;
+        }
+
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+
+        for (short k = 0; k < BK; k++) {
+            float a[4];
+            float b[4];
+            for (short i = 0; i < 4; i++) {
+                a[i] = sa[k*BM + tx + 16*i];
+                b[i] = sb[k*BN + ty + 16*i];
+            }
+            for (short i = 0; i < 4; i++) {
+                for (short j = 0; j < 4; j++) {
+                    acc[i][j] = fma(a[i], b[j], acc[i][j]);
+                }
+            }
+        }
+
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+
+    device float * d = (device float *) dst + (uint64_t) im*args.ne1*args.ne0;
+
+    for (short j = 0; j < 4; j++) {
+        const int n = r1 + ty + 16*j;
+        if (n >= args.ne1) {
+            continue;
+        }
+        for (short i = 0; i < 4; i++) {
+            const int m = r0 + tx + 16*i;
+            if (m < args.ne0) {
+                d[(uint64_t) n*args.ne0 + m] = acc[i][j];
+            }
+        }
+    }
+}
+
+typedef decltype(kernel_mul_mm_tg<float, float>) mul_mm_tg_t;
+
+template [[host_name("kernel_mul_mm_tg_f32_f32")]] kernel mul_mm_tg_t kernel_mul_mm_tg<float, float>;
+template [[host_name("kernel_mul_mm_tg_f32_f16")]] kernel mul_mm_tg_t kernel_mul_mm_tg<float, half>;
+template [[host_name("kernel_mul_mm_tg_f16_f32")]] kernel mul_mm_tg_t kernel_mul_mm_tg<half,  float>;
+template [[host_name("kernel_mul_mm_tg_f16_f16")]] kernel mul_mm_tg_t kernel_mul_mm_tg<half,  half>;
