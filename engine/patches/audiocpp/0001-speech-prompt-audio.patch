+    // ox-say: one bound on reference audio, shared by the voice_ref base64
+    // payload below, the voice_ref path forms and the prompt_audio file added
+    // after reference_text (ox-say #137.2, #366).
+    constexpr size_t kMaxVoiceRefBytes = size_t{5} * 1024 * 1024;
+    // ox-say: every reference file is decoded whole, so it is checked before the
+    // read: a non-regular file (a FIFO would block the decode, a device never
+    // ends) and a file over the cap both answer a clean 400 (CapacityError, the
+    // one error that maps to 400), not a hang or a decode-time allocation spike.
+    // A missing or unstat-able path falls through to read_audio_buffer, which
+    // reports an unreadable file as before (ox-say #366).
+    const auto read_reference_file = [&](const std::filesystem::path & path, const char * what) {
+        std::error_code ec;
+        const auto status = std::filesystem::status(path, ec);
+        if (!ec && std::filesystem::exists(status) && !std::filesystem::is_regular_file(status)) {
+            throw engine::runtime::CapacityError(std::string(what) + " is not a regular file");
+        }
+        const auto size = std::filesystem::file_size(path, ec);
+        if (!ec && size > kMaxVoiceRefBytes) {
+            throw engine::runtime::CapacityError(std::string(what) + " exceeds the 5 MiB limit");
+        }
+        return minitts::cli::read_audio_buffer(path);
+    };
